# Example only: replace placeholders and never commit .env
JWT_SECRET_KEY=REPLACE_WITH_A_SECURE_RANDOM_SECRET
# DB_PASSWORD=REPLACE_WITH_YOUR_PASSWORD
REDIS_URL=redis://127.0.0.1:6379/0

# RabbitMQ async note operations (default sync preserves existing behavior)
NOTE_WRITE_MODE=sync
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=jotang
# RABBITMQ_PASSWORD=REPLACE_WITH_YOUR_PASSWORD

# Advanced Part 1-4 /chat; YosHub uses OpenAI Chat Completions.
# Verified with real YosHub API on 2026-10-14: DeepSeek V4.1 Flash.
