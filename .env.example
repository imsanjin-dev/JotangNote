# Example only: replace placeholders and never commit .env
JWT_SECRET_KEY=REPLACE_WITH_A_SECURE_RANDOM_SECRET
# DB_PASSWORD=REPLACE_WITH_YOUR_PASSWORD
REDIS_URL=redis://127.0.0.1:6379/0

# For recruit Part 3, start RabbitMQ and the note_worker.py before the API.
# Use sync temporarily only if the broker is unavailable for earlier CRUD practice.
NOTE_WRITE_MODE=async
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=jotang
# RABBITMQ_PASSWORD=REPLACE_WITH_YOUR_PASSWORD

# Advanced Part 1-4 /chat; YosHub uses OpenAI Chat Completions.
# Example model ID for this compatible proxy.
AI_BASE_URL=https://api2.yoshub.com/v1
AI_MODEL=deepseek-v4.1-flash
# AI_API_KEY=YOUR_PRIVATE_YOSHUB_TOKEN
# MiMo alternative: https://api.xiaomimimo.com/v1 / mimo-v2.6-flash
